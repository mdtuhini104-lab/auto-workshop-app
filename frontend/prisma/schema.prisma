generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            Int           @id @default(autoincrement())
  username      String        @unique
  password_hash String
  role          String        @default("Mechanic")
  created_at    DateTime      @default(now())
  inspections   Inspection[]
  job_cards     JobCard[]
}

model Customer {
  id         Int       @id @default(autoincrement())
  name       String
  phone      String
  email      String?
  address    String?
  created_at DateTime  @default(now())
  vehicles   Vehicle[]
}

model Vehicle {
  id             Int             @id @default(autoincrement())
  customer_id    Int
  make           String
  model          String
  year           Int
  license_plate  String          @unique
  chassis_number String          @unique
  created_at     DateTime        @default(now())
  customer       Customer        @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  intakes        VehicleIntake[]
}

model InventoryPart {
  id             Int              @id @default(autoincrement())
  part_name      String
  part_number    String           @unique
  stock_quantity Int              @default(0)
  price          Float
  created_at     DateTime         @default(now())
  items          InspectionItem[]
}

model VehicleIntake {
  id                Int          @id @default(autoincrement())
  vehicle_id        Int
  intake_date       DateTime     @default(now())
  driver_complaints String
  status            String       @default("Pending Inspection")
  vehicle           Vehicle      @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
  inspections       Inspection[]
  quotations        Quotation[]
}

model Inspection {
  id              Int              @id @default(autoincrement())
  intake_id       Int
  mechanic_id     Int
  inspection_date DateTime         @default(now())
  findings        String?
  intake          VehicleIntake    @relation(fields: [intake_id], references: [id], onDelete: Cascade)
  mechanic        User             @relation(fields: [mechanic_id], references: [id], onDelete: Cascade)
  items           InspectionItem[]
}

model InspectionItem {
  id             Int            @id @default(autoincrement())
  inspection_id  Int
  part_id        Int?
  description    String
  part_source    String         @default("Inventory")
  quantity       Int            @default(1)
  service_charge Float          @default(0.0)
  inspection     Inspection     @relation(fields: [inspection_id], references: [id], onDelete: Cascade)
  part           InventoryPart? @relation(fields: [part_id], references: [id], onDelete: SetNull)
}

model Quotation {
  id                   Int           @id @default(autoincrement())
  intake_id            Int
  total_parts_cost     Float         @default(0.0)
  total_service_charge Float         @default(0.0)
  grand_total          Float         @default(0.0)
  status               String        @default("Draft")
  created_at           DateTime      @default(now())
  intake               VehicleIntake @relation(fields: [intake_id], references: [id], onDelete: Cascade)
  work_orders          WorkOrder[]
}

model WorkOrder {
  id              Int         @id @default(autoincrement())
  quotation_id    Int
  status          String      @default("Pending")
  start_date      DateTime    @default(now())
  completion_date DateTime?
  quotation       Quotation   @relation(fields: [quotation_id], references: [id], onDelete: Cascade)
  job_cards       JobCard[]
  invoices        Invoice[]
}

model JobCard {
  id               Int       @id @default(autoincrement())
  work_order_id    Int
  mechanic_id      Int
  task_description String
  status           String    @default("Assigned")
  created_at       DateTime  @default(now())
  work_order       WorkOrder @relation(fields: [work_order_id], references: [id], onDelete: Cascade)
  mechanic         User      @relation(fields: [mechanic_id], references: [id], onDelete: Cascade)
}

model Invoice {
  id            Int       @id @default(autoincrement())
  work_order_id Int
  amount_due    Float
  status        String    @default("Unpaid")
  issued_at     DateTime  @default(now())
  work_order    WorkOrder @relation(fields: [work_order_id], references: [id], onDelete: Cascade)
}
